composer.phar

# Local-only debug / migration scripts (must NOT be deployed)
# The project root sits inside the web docroot on Hostinger, so anything here is
# HTTP-reachable. These connect to the production DB, dump customer records, or
# send live mail — several were publicly executable until 2026-07-27.
run_migration.php
create_test_user.php
check_sessions.php
check_sessions2.php
