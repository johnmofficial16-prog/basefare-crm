# =============================================================================
# BaseFare CRM — environment template
# Copy to .env and fill in real values. NEVER commit .env (gitignored).
# Every key the app reads is listed here; keep this file in sync when adding
# new $_ENV reads.
# =============================================================================

# --- Application -------------------------------------------------------------
# local = show error details in browser; production = friendly error pages.
# Staging: use APP_ENV=production with APP_DEBUG=true (details visible, but
# all production code paths exercised).
APP_ENV=production
APP_URL=https://crm.base-fare.com
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# --- Card-data encryption ----------------------------------------------------
# CRITICAL: losing these keys makes every stored card unrecoverable. They are
# NOT in git and NOT in backups by design — keep an offline copy somewhere
# safe. See scripts/rotate_encryption_keys.php before ever changing them.
ENCRYPTION_KEY_A=
ENCRYPTION_KEY_B=

# --- Sessions ----------------------------------------------------------------
SESSION_LIFETIME=120
SESSION_DRIVER=file

# --- Outbound mail (SMTP) ----------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME="Base Fare"

# --- Inbound mail (IMAP — customer email replies) ----------------------------
IMAP_ENABLED=false
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_USER=
IMAP_PASS=

# --- AI (Vertex AI Express Mode) ---------------------------------------------
# "AQ."-prefixed Express key. Only the Express publishers/google endpoint
# accepts it — see app/Services/GeminiService.php header before touching.
VERTEX_API_KEY=
VERTEX_MODEL=gemini-2.5-flash

# --- AI Buddy ----------------------------------------------------------------
# Global kill switch. false = widget hidden everywhere + all buddy chat
# endpoints refuse politely. One edit, no deploy. Default true.
BUDDY_ENABLED=true
# Gemini price estimate for the maintenance buddy's cost tile (USD per 1M
# tokens). Update if Google's pricing changes — no deploy needed.
BUDDY_PRICE_IN=0.30
BUDDY_PRICE_OUT=2.50
